<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center">

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="480dp"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <!-- region # body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#FFFFFF"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/admixer_banner_native_icon"
                android:layout_width="70dp"
                android:layout_height="70dp"
                tools:background="#FF0000" />

            <TextView
                android:id="@+id/admixer_banner_native_advertiser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="1sp"
                android:textColor="#c7c7c7"
                android:textSize="8sp"
                android:visibility="gone"
                tools:text="native ad advertiser" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingLeft="2dp"
                android:paddingEnd="2dp"
                android:paddingRight="2dp"
                android:background="@color/acb_adcash_ssp_ad_color_banner_background">

                <TextView
                    android:id="@+id/admixer_banner_native_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#212121"
                    android:textSize="14dp"
                    android:textStyle="bold"
                    tools:text="native ad title" />

                <TextView
                    android:id="@+id/admixer_banner_native_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#212121"
                    android:textSize="12dp"
                    tools:text="native ad description" />

            </LinearLayout>

        </LinearLayout>
        <!-- endregion -->

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <!-- region # image -->

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true">

            <com.nasmedia.admixer.common.nativeads.NativeMainAdView
                android:id="@+id/admixer_banner_native_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                tools:background="#99CCFF"/>

        </RelativeLayout>

        <!-- endregion -->

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <!-- region # cta -->
        <Button
            android:id="@+id/admixer_banner_native_cta"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/acb_adcash_archive_dr_ic_cta"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textColorHint="#D8D8D8"
            android:textSize="14dp"
            tools:text="call to action" />
        <!-- endregion -->

    </LinearLayout>

</RelativeLayout>